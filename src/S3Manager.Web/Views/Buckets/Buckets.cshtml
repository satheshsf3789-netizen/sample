@model IReadOnlyList<BucketInfo>

@{
    ViewData["Title"] = "Buckets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Buckets</h2>
    <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBucketModal">New Bucket</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <p>No buckets found. Create one to get started.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Bucket Name</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bucket in Model)
                {
                    <tr>
                        <td><strong>@bucket.Name</strong></td>
                        <td>@bucket.CreationDate?.ToUniversalTime().ToString("g")</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-info">Browse</a>
                            <a href="#" class="btn btn-sm btn-warning">Details</a>
                            <a href="#" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Create Bucket Modal -->
<div class="modal fade" id="createBucketModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Bucket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">Bucket Name</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="region" class="form-label">Region</label>
                        <select class="form-select" id="region" name="region">
                            <option value="us-east-1">US East (N. Virginia)</option>
                            <option value="us-west-2">US West (Oregon)</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="versioning" name="versioning">
                        <label class="form-check-label" for="versioning">
                            Enable versioning
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
