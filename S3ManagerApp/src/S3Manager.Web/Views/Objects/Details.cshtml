@model ObjectDetails

@{
    ViewData["Title"] = "Object Details";
    var bucket = ViewData["Bucket"];
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Buckets" asp-action="Buckets">Buckets</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Objects" asp-action="List" asp-route-bucket="@bucket">@bucket</a>
            </li>
            <li class="breadcrumb-item active">@Model.Key</li>
        </ol>
    </nav>
</div>

<h2>Object Details</h2>

<div class="card">
    <div class="card-header bg-dark text-white">
        <h5>@Model.Key</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Size:</strong>
                <p>@(Model.SizeBytes.HasValue ? $"{Model.SizeBytes / 1024} KB" : "N/A")</p>
            </div>
            <div class="col-md-6">
                <strong>Last Modified:</strong>
                <p>@Model.LastModifiedUtc?.ToUniversalTime().ToString("G")</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Content Type:</strong>
                <p>@(Model.ContentType ?? "N/A")</p>
            </div>
            <div class="col-md-6">
                <strong>Storage Class:</strong>
                <p>@(Model.StorageClass ?? "N/A")</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <strong>ETag:</strong>
                <p><code>@(Model.ETag ?? "N/A")</code></p>
            </div>
        </div>

        @if (Model.Metadata.Count > 0)
        {
            <div class="row mb-3">
                <div class="col-md-12">
                    <strong>Metadata:</strong>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            @foreach (var meta in Model.Metadata)
                            {
                                <tr>
                                    <td><code>@meta.Key</code></td>
                                    <td>@meta.Value</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Objects" asp-action="Download" asp-route-bucket="@bucket" asp-route-key="@Model.Key" class="btn btn-primary">Download</a>
    <a asp-controller="Objects" asp-action="List" asp-route-bucket="@bucket" class="btn btn-secondary">Back to Bucket</a>
</div>
