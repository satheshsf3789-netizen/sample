@{
    ViewData["Title"] = "Upload File";
    var bucket = ViewData["Bucket"];
    var prefix = ViewData["Prefix"];
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Buckets" asp-action="Buckets">Buckets</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Objects" asp-action="List" asp-route-bucket="@bucket">@bucket</a>
            </li>
            <li class="breadcrumb-item active">Upload</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Upload File</h4>
            </div>
            <div class="card-body">
                <form method="post" asp-action="Upload" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    
                    <input type="hidden" name="bucket" value="@bucket">
                    <input type="hidden" name="prefix" value="@prefix">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="mb-3">
                        <label for="file" class="form-label">Select File</label>
                        <input type="file" class="form-control" id="file" name="file" required>
                        <small class="form-text text-muted">Max 100 MB</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Upload</button>
                        <a asp-controller="Objects" asp-action="List" asp-route-bucket="@bucket" asp-route-prefix="@prefix" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
