@model ObjectPage

@{
    ViewData["Title"] = $"Browse - {ViewData["Bucket"]}";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Buckets" asp-action="Buckets">Buckets</a>
            </li>
            <li class="breadcrumb-item active">@Model.Bucket</li>
            @if (!string.IsNullOrWhiteSpace(Model.Prefix))
            {
                <li class="breadcrumb-item active">@Model.Prefix</li>
            }
        </ol>
    </nav>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Browse: @Model.Bucket</h2>
    <div class="btn-group" role="group">
        <a asp-action="Upload" asp-route-bucket="@Model.Bucket" asp-route-prefix="@Model.Prefix" class="btn btn-success">Upload File</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createFolderModal">New Folder</button>
    </div>
</div>

@if (Model.Objects.Count == 0 && Model.Folders.Count == 0)
{
    <div class="alert alert-info">
        <p>This bucket/folder is empty.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Modified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Folders -->
                @foreach (var folder in Model.Folders)
                {
                    var folderPath = string.IsNullOrWhiteSpace(Model.Prefix) ? folder : $"{Model.Prefix.TrimEnd('/')}/{folder}";
                    <tr>
                        <td>
                            <i class="bi bi-folder-fill"></i>
                            <a asp-action="List" asp-route-bucket="@Model.Bucket" asp-route-prefix="@folderPath">
                                @folder
                            </a>
                        </td>
                        <td>-</td>
                        <td>-</td>
                        <td>-</td>
                    </tr>
                }

                <!-- Objects -->
                @foreach (var obj in Model.Objects)
                {
                    <tr>
                        <td>@obj.FileName</td>
                        <td>@(obj.SizeBytes.HasValue ? $"{obj.SizeBytes / 1024} KB" : "-")</td>
                        <td>@obj.LastModifiedUtc?.ToUniversalTime().ToString("g")</td>
                        <td>
                            <a asp-action="Details" asp-route-bucket="@Model.Bucket" asp-route-key="@obj.Key" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Download" asp-route-bucket="@Model.Bucket" asp-route-key="@obj.Key" class="btn btn-sm btn-primary">Download</a>
                            <form method="post" asp-action="Delete" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bucket" value="@Model.Bucket">
                                <input type="hidden" name="key" value="@obj.Key">
                                <input type="hidden" name="prefix" value="@Model.Prefix">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this object?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.HasMore && !string.IsNullOrWhiteSpace(Model.NextToken))
    {
        <nav aria-label="pagination">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" asp-action="List" asp-route-bucket="@Model.Bucket" asp-route-prefix="@Model.Prefix" asp-route-token="@Model.NextToken">Next</a>
                </li>
            </ul>
        </nav>
    }
}

<!-- Create Folder Modal -->
<div class="modal fade" id="createFolderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateFolder">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="bucket" value="@Model.Bucket">
                    <input type="hidden" name="prefix" value="@Model.Prefix">
                    <div class="mb-3">
                        <label for="folderName" class="form-label">Folder Name</label>
                        <input type="text" class="form-control" id="folderName" name="folderName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
